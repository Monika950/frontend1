# Google Maps API Key
# Get your API key from: https://console.cloud.google.com/google/maps-apis
# Restrict the key to your app's package name and SHA-1 certificate fingerprint
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

